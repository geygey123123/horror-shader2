#version 120

// ============================================================================
// MINIMAL TEST SHADER - Vertex Shader
// ТЕСТОВЫЙ ШЕЙДЕР: Простая передача координат текстуры
// ============================================================================

varying vec2 texcoord;

void main() {
    // Стандартная трансформация вершины
    gl_Position = ftransform();
    
    // Передаём UV-координаты из входных данных
    // В post-процессинге они обычно уже нормализованы [0, 1]
    texcoord = gl_MultiTexCoord0.xy;
}
